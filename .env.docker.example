# ===============================================
# InkSight Docker 单容器部署环境变量配置模板
# 复制此文件为 .env：cp .env.docker.example .env
# ===============================================

# 外部映射端口
WEB_PORT=3000
BACKEND_PORT=8080

# 大语言模型 API Key (任选一个或多个配置)
# 推荐 DeepSeek (deepseek-chat)
DEEPSEEK_API_KEY=

# 阿里百炼 DashScope (通义千问 / Qwen / 生图)
DASHSCOPE_API_KEY=

# 月之暗面 Moonshot Kimi
MOONSHOT_API_KEY=

# 天气与生活指数 (可选，默认使用 Open-Meteo 免 Key)
OPENWEATHER_API_KEY=
TIANAPI_KEY=
