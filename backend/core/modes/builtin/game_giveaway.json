{
  "mode_id": "GAME_GIVEAWAY",
  "display_name": "喜加一",
  "icon": "gift",
  "cacheable": true,
  "description": "Epic 或 Steam 限时免费游戏，封面背景配领取截止时间",
  "settings_schema": [
    {
      "key": "source",
      "label": "游戏平台",
      "type": "select",
      "default": "EPIC",
      "options": [
        { "value": "EPIC", "label": "Epic Games" },
        { "value": "STEAM", "label": "Steam" }
      ]
    },
    {
      "key": "endpoint",
      "label": "公开数据接口（可选）",
      "type": "text",
      "placeholder": "https://example.com/giveaway.json"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "game_giveaway",
    "fallback": {
      "source": "EPIC",
      "source_label": "EPIC",
      "game_title": "The Escapists 2",
      "deadline_label": "限时领取",
      "cover_url": "https://dummyimage.com/640x360/e8e8e8/222222.png&text=THE+ESCAPISTS+2",
      "claim_url": "https://store.epicgames.com/",
      "description": "本周免费领取游戏"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": { "line_width": 1, "dashed": false },
    "body": [
      {
        "type": "game_giveaway",
        "width": 380,
        "height": 220,
        "cover_field": "cover_url",
        "source_field": "source_label",
        "deadline_field": "deadline_label",
        "title_field": "game_title",
        "fit": "contain",
        "margin": 8,
        "margin_bottom": 4
      }
    ],
    "footer": {
      "label": "GAME GIVEAWAY",
      "attribution_template": "{source_label} · {deadline_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "game_giveaway",
          "width": 284,
          "height": 82,
          "cover_field": "cover_url",
          "source_field": "source_label",
          "deadline_field": "deadline_label",
          "title_field": "game_title",
          "fit": "contain",
          "margin": 5,
          "source_font_size": 9,
          "deadline_font_size": 8,
          "title_font_size": 10,
          "margin_bottom": 0
        }
      ]
    }
  }
}
