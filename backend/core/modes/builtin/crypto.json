{
  "mode_id": "CRYPTO",
  "display_name": "资产行情",
  "icon": "trending-up",
  "cacheable": true,
  "description": "实时监控主流加密货币或全球股票资产价格、涨跌幅与分时趋势折线图",
  "settings_schema": [
    {
      "key": "symbol",
      "label": "资产/股票代码",
      "type": "select",
      "default": "BTC",
      "options": [
        { "value": "BTC", "label": "Bitcoin (BTC)" },
        { "value": "ETH", "label": "Ethereum (ETH)" },
        { "value": "SOL", "label": "Solana (SOL)" },
        { "value": "DOGE", "label": "Dogecoin (DOGE)" },
        { "value": "AAPL", "label": "Apple 苹果 (AAPL)" },
        { "value": "TSLA", "label": "Tesla 特斯拉 (TSLA)" },
        { "value": "NVDA", "label": "NVIDIA 英伟达 (NVDA)" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "crypto",
    "symbol": "BTC",
    "fallback": {
      "symbol": "BTC/USDT",
      "name": "Bitcoin 比特币",
      "price": "$64,280.50",
      "change_24h": "+3.45%",
      "is_up": true,
      "high_24h": "$65,100.00",
      "low_24h": "$62,900.00",
      "update_time": "实时",
      "sparkline_data": [62900, 63100, 63400, 63200, 63800, 64100, 63900, 64500, 64800, 64280]
    }
  },
  "layout": {
    "body_align": "center",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 10
      },
      {
        "type": "text",
        "field": "name",
        "font": "noto_serif_bold",
        "font_size": 20,
        "line_height": 24,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "text",
        "field": "symbol",
        "font": "noto_serif_regular",
        "font_size": 13,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 10
      },
      {
        "type": "text",
        "field": "price",
        "font": "noto_serif_bold",
        "font_size": 36,
        "line_height": 40,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 8
      },
      {
        "type": "text",
        "field": "change_24h",
        "color": "red",
        "font": "noto_serif_bold",
        "font_size": 18,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 10
      },
      {
        "type": "sparkline",
        "field": "sparkline_data",
        "height": 42,
        "line_width": 2,
        "margin_x": 24,
        "show_baseline": true,
        "show_endpoints": true,
        "color": "red"
      },
      {
        "type": "separator",
        "line_width": 1,
        "dashed": true
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "key_value",
        "items": [
          { "label": "24h 最高", "field": "high_24h" },
          { "label": "24h 最低", "field": "low_24h" }
        ],
        "font_size": 12,
        "align": "center"
      }
    ],
    "footer": {
      "label": "行情趋势追踪",
      "attribution_template": "更新于 {update_time}"
    }
  }
}
