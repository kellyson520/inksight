{
  "mode_id": "CPA_QUOTA",
  "display_name": "Quota & Auth Dashboard",
  "icon": "gauge",
  "category": "productivity",
  "cacheable": false,
  "description": "Monitors local CPA & Keeper auth files reset times, used volumes, user billing and model rankings",
  "settings_schema": [
    {
      "key": "view",
      "label": "Dashboard View",
      "type": "select",
      "options": [
        { "value": "auths", "label": "Auth Files & Quotas" },
        { "value": "overview", "label": "Comprehensive Overview" },
        { "value": "users", "label": "User Billing Ranking" },
        { "value": "models", "label": "Model Usage Ranking" }
      ],
      "default": "auths"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "cpa_quota",
    "fallback": {
      "title": "Auth Files & Quota Status",
      "header_status": "CPA Online · Keeper Online",
      "summary_1_label": "Auth Files",
      "summary_1_val": "4 Files",
      "summary_2_label": "Next Quota Reset",
      "summary_2_val": "3h 38m",
      "summary_3_label": "Today Tokens",
      "summary_3_val": "75.3M",
      "col_left_title": "🔑 Auth Account / Provider",
      "col_right_title": "⏳ Reset Time & Used Volume",
      "card_1_left_name": "CODEX · AA",
      "card_1_left_val": "Used: 2.87B (26138 reqs)",
      "card_1_right_name": "AA Quota",
      "card_1_right_val": "Reset: 3h 38m (85% left)",
      "card_2_left_name": "ANTIGRAVITY · huo02",
      "card_2_left_val": "Used: 482.9M (3370 reqs)",
      "card_2_right_name": "huo02 Quota",
      "card_2_right_val": "Reset: No Limit (100% left)",
      "card_3_left_name": "GEMINI · h",
      "card_3_left_val": "Used: 224.0K (43 reqs)",
      "card_3_right_name": "h Quota",
      "card_3_right_val": "Reset: No Limit (100% left)",
      "reset_bottom_label": "Auths: 4 · Reset in: 3h 38m",
      "update_time": "12:00:00"
    }
  },
