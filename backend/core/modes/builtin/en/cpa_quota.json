          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_x": 4,
            "items": [
              {
                "type": "text",
                "field": "title",
                "font": "lora_bold",
                "font_size": 14
              },
              {
                "type": "badge",
