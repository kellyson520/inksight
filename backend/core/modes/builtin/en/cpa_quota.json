{
  "mode_id": "CPA_QUOTA",
  "display_name": "Quota & Auth Dashboard",
  "icon": "gauge",
  "category": "productivity",
  "cacheable": false,
  "description": "Monitors local CPA & Keeper auth files reset times, used volumes, user billing and model rankings",
  "settings_schema": [
    {
      "key": "view",
      "label": "Dashboard View",
      "type": "select",
      "options": [
        { "value": "auths", "label": "Auth Files & Quotas" },
        { "value": "overview", "label": "Comprehensive Overview" },
        { "value": "users", "label": "User Billing Ranking" },
        { "value": "models", "label": "Model Usage Ranking" }
      ],
      "default": "auths"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "cpa_quota",
    "fallback": {
      "title": "Auth Files & Quota Status",
      "header_status": "CPA Online · Keeper Online",
      "summary_1_label": "Active Files",
      "summary_1_val": "2 Files",
      "summary_2_label": "5h Window Reset",
      "summary_2_val": "2h 45m",
      "summary_3_label": "7d Window Reset",
      "summary_3_val": "6d 0h",
      "card_1_title": "AA  [CODEX]",
      "card_1_status": "• Active",
      "card_1_reset_text": "5h Reset: 2h 45m   7d Reset: 6d 0h",
      "card_1_usage_text": "Used: 2.87B Tokens · 26,139 reqs",
      "card_1_ring_val": "85",
      "card_1_ring_text": "85%",
      "card_1_ring_label": "Quota Left",
      "card_2_title": "huo02  [ANTIGRAVITY]",
      "card_2_status": "• Active",
      "card_2_reset_text": "5h Reset: Active   7d Reset: Active",
      "card_2_usage_text": "Used: 485.5M Tokens · 3,370 reqs",
      "card_2_ring_val": "100",
      "card_2_ring_text": "100%",
      "card_2_ring_label": "Full Quota",
      "reset_bottom_label": "Active Auths: 2  ·  Today Tokens: 85.6M",
      "update_time": "12:00:00"
    }
  },
  "layout": {
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 4,
        "padding": 5,
        "margin_x": 8,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_x": 4,
            "items": [
              {
                "type": "text",
                "field": "title",
                "font": "lora_bold",
                "font_size": 14
              },
              {
                "type": "badge",
                "field": "header_status",
                "font_size": 10,
                "padding_x": 6,
                "padding_y": 1
              }
            ]
          }
        ]
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 4,
        "padding": 5,
        "margin_x": 8,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-around",
            "align_items": "center",
            "items": [
              {
                "type": "text",
                "field": "summary_1_label",
                "font": "inter_medium",
                "font_size": 10,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_2_label",
                "font": "inter_medium",
                "font_size": 10,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_3_label",
                "font": "inter_medium",
                "font_size": 10,
                "align": "center"
              }
            ]
          },
          {
            "type": "flex_row",
            "justify": "space-around",
            "align_items": "center",
            "margin_top": 2,
            "items": [
              {
                "type": "text",
                "field": "summary_1_val",
                "font": "lora_bold",
                "font_size": 14,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_2_val",
                "font": "lora_bold",
                "font_size": 14,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_3_val",
