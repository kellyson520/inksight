{
  "mode_id": "CPA_QUOTA",
  "display_name": "Quota & Auth Dashboard",
  "icon": "gauge",
  "category": "productivity",
  "cacheable": false,
  "description": "Monitors local CPA & Keeper auth files reset times, used volumes, user billing and model rankings",
  "settings_schema": [
    {
      "key": "view",
      "label": "Dashboard View",
      "type": "select",
      "options": [
        { "value": "auths", "label": "Auth Files & Quotas" },
        { "value": "overview", "label": "Comprehensive Overview" },
        { "value": "users", "label": "User Billing Ranking" },
        { "value": "models", "label": "Model Usage Ranking" }
      ],
      "default": "auths"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "cpa_quota",
    "fallback": {
      "title": "Auth Files & Quota Status",
      "header_status": "CPA Online · Keeper Online",
      "summary_1_label": "Active Files",
      "summary_1_val": "2 Files",
      "summary_2_label": "5h Window Reset",
      "summary_2_val": "2h 45m",
      "summary_3_label": "7d Window Reset",
      "summary_3_val": "6d 0h",
      "card_1_title": "AA  [CODEX]",
      "card_1_status": "• Active",
      "card_1_reset_text": "5h Reset: 2h 45m   7d Reset: 6d 0h",
      "card_1_usage_text": "Used: 2.87B Tokens · 26,139 reqs",
      "card_1_ring_val": "85",
      "card_2_title": "huo02  [ANTIGRAVITY]",
      "card_2_status": "• Active",
      "card_2_reset_text": "5h Reset: Active   7d Reset: Active",
      "card_2_usage_text": "Used: 485.5M Tokens · 3,370 reqs",
      "card_2_ring_val": "100",
      "reset_bottom_label": "Active Auths: 2  ·  Today Tokens: 85.6M",
      "update_time": "12:00:00"
    }
  },
  "layout": {
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 3
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 4,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_x": 4,
            "margin_bottom": 0,
            "items": [
              {
                "type": "text",
                "field": "title",
                "font": "lora_bold",
                "font_size": 13
              },
              {
                "type": "badge",
                "field": "header_status",
                "font_size": 9,
                "padding_x": 5,
                "padding_y": 1
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 4,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-around",
            "align_items": "center",
            "margin_bottom": 1,
            "items": [
              {
                "type": "text",
                "field": "summary_1_label",
                "font": "inter_medium",
                "font_size": 9,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_2_label",
                "font": "inter_medium",
                "font_size": 9,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_3_label",
                "font": "inter_medium",
                "font_size": 9,
                "align": "center"
              }
            ]
          },
          {
            "type": "flex_row",
            "justify": "space-around",
            "align_items": "center",
            "margin_bottom": 0,
            "items": [
              {
                "type": "text",
                "field": "summary_1_val",
                "font": "lora_bold",
                "font_size": 13,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_2_val",
                "font": "lora_bold",
                "font_size": 13,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_3_val",
                "font": "lora_bold",
                "font_size": 13,
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 5,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "two_column",
            "ratio": 0.82,
            "margin_x": 0,
            "gap": 6,
            "left_align_y": "center",
            "right_align_y": "center",
            "left": [
              {
                "type": "flex_row",
                "justify": "left",
                "align_items": "center",
                "margin_bottom": 3,
                "items": [
                  { "type": "text", "field": "card_1_title", "font": "lora_bold", "font_size": 11 },
                  { "type": "spacer", "width": 6 },
                  { "type": "text", "field": "card_1_status", "font": "inter_medium", "font_size": 9 }
                ]
              },
              {
                "type": "text",
                "field": "card_1_reset_text",
                "font": "lora_bold",
                "font_size": 10,
                "margin_bottom": 2
              },
              {
                "type": "text",
                "field": "card_1_usage_text",
                "font": "inter_medium",
                "font_size": 9,
                "margin_bottom": 0
              }
            ],
            "right": [
              {
                "type": "progress_ring",
                "field": "card_1_ring_val",
                "color_by_percent": true,
                "color_field": "card_1_ring_color",
                "size": 42,
                "label": "Quota",
                "margin_bottom": 0
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 5,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "two_column",
            "ratio": 0.82,
            "margin_x": 0,
            "gap": 6,
            "left_align_y": "center",
            "right_align_y": "center",
            "left": [
              {
                "type": "flex_row",
                "justify": "left",
                "align_items": "center",
                "margin_bottom": 3,
                "items": [
                  { "type": "text", "field": "card_2_title", "font": "lora_bold", "font_size": 11 },
                  { "type": "spacer", "width": 6 },
                  { "type": "text", "field": "card_2_status", "font": "inter_medium", "font_size": 9 }
                ]
              },
              {
                "type": "text",
                "field": "card_2_reset_text",
                "font": "lora_bold",
                "font_size": 10,
                "margin_bottom": 2
              },
              {
                "type": "text",
                "field": "card_2_usage_text",
                "font": "inter_medium",
                "font_size": 9,
                "margin_bottom": 0
              }
            ],
            "right": [
              {
                "type": "progress_ring",
                "field": "card_2_ring_val",
                "color_by_percent": true,
                "color_field": "card_2_ring_color",
                "size": 42,
                "label": "Full",
                "margin_bottom": 0
              }
            ]
          }
        ]
      },
      {
        "type": "flex_row",
        "justify": "space-between",
        "align_items": "center",
        "margin_x": 10,
        "margin_bottom": 0,
        "items": [
          {
            "type": "text",
            "field": "reset_bottom_label",
            "font": "inter_medium",
            "font_size": 9
          },
          {
            "type": "text",
            "field": "update_time",
            "font": "inter_medium",
            "font_size": 9
          }
        ]
      }
    ]
  }
}
