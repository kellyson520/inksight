{
  "mode_id": "CRYPTO",
  "display_name": "Market Ticker",
  "icon": "trending-up",
  "cacheable": true,
  "description": "Live cryptocurrency and stock ticker with 24h trend sparkline chart",
  "settings_schema": [
    {
      "key": "symbol",
      "label": "Asset/Stock Symbol",
      "type": "select",
      "default": "BTC",
      "options": [
        { "value": "BTC", "label": "Bitcoin (BTC)" },
        { "value": "ETH", "label": "Ethereum (ETH)" },
        { "value": "SOL", "label": "Solana (SOL)" },
        { "value": "DOGE", "label": "Dogecoin (DOGE)" },
        { "value": "AAPL", "label": "Apple (AAPL)" },
        { "value": "TSLA", "label": "Tesla (TSLA)" },
        { "value": "NVDA", "label": "NVIDIA (NVDA)" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "crypto",
    "symbol": "BTC",
    "fallback": {
      "symbol": "BTC/USDT",
      "name": "Bitcoin",
      "price": "$64,280.50",
      "change_24h": "+3.45%",
      "is_up": true,
      "high_24h": "$65,100.00",
      "low_24h": "$62,900.00",
      "update_time": "Realtime",
      "sparkline_data": [62900, 63100, 63400, 63200, 63800, 64100, 63900, 64500, 64800, 64280]
    }
  },
  "layout": {
    "body_align": "center",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 10
      },
      {
        "type": "flex_row",
        "justify": "center",
        "align_items": "center",
        "gap": 8,
        "items": [
          {
            "type": "text",
            "field": "name",
            "font": "noto_serif_bold",
            "font_size": 20
          },
          {
            "type": "badge",
            "field": "symbol",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          }
        ]
      },
      {
        "type": "spacer",
        "height": 10
      },
      {
        "type": "flex_row",
        "justify": "center",
        "align_items": "center",
        "gap": 12,
        "items": [
          {
            "type": "text",
            "field": "price",
            "font": "noto_serif_bold",
            "font_size": 34
          },
          {
            "type": "badge",
            "field": "change_24h",
            "variant": "solid",
            "bg_color": "red",
            "color": "white",
            "font_size": 13,
            "padding_x": 8,
            "padding_y": 3,
            "radius": 6
          }
        ]
      },
      {
        "type": "spacer",
        "height": 8
      },
      {
        "type": "sparkline",
        "field": "sparkline_data",
        "height": 44,
        "line_width": 2,
        "margin_x": 20,
        "show_baseline": true,
        "show_endpoints": true,
        "color": "red"
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "grid",
        "columns": 2,
        "show_divider": true,
        "margin_x": 30,
        "font_size": 11,
        "value_size": 13,
        "items": [
          { "label": "24h High", "field": "high_24h", "align": "center" },
          { "label": "24h Low", "field": "low_24h", "align": "center" }
        ]
      }
    ],
    "footer": {
      "label": "Market Trend Tracker",
      "attribution_template": "Updated at {update_time}"
    }
  }
}
