{
  "mode_id": "CRYPTO",
  "display_name": "Crypto Ticker",
  "icon": "trending-up",
  "cacheable": true,
  "description": "Live cryptocurrency ticker with 24h change and price range",
  "settings_schema": [
    {
      "key": "symbol",
      "label": "Asset Symbol",
      "type": "select",
      "default": "BTC",
      "options": [
        { "value": "BTC", "label": "Bitcoin (BTC)" },
        { "value": "ETH", "label": "Ethereum (ETH)" },
        { "value": "SOL", "label": "Solana (SOL)" },
        { "value": "BNB", "label": "BNB (BNB)" },
        { "value": "DOGE", "label": "Dogecoin (DOGE)" },
        { "value": "XRP", "label": "Ripple (XRP)" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "crypto",
    "symbol": "BTC",
    "fallback": {
      "symbol": "BTC/USDT",
      "name": "Bitcoin",
      "price": "$64,280.50",
      "change_24h": "+3.45%",
      "is_up": true,
      "high_24h": "$65,100.00",
      "low_24h": "$62,900.00",
      "update_time": "Realtime"
    }
  },
  "layout": {
    "body_align": "center",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 12
      },
      {
        "type": "text",
        "field": "name",
        "font": "noto_serif_bold",
        "font_size": 22,
        "line_height": 26,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "text",
        "field": "symbol",
        "font": "noto_serif_regular",
        "font_size": 14,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 12
      },
      {
        "type": "text",
        "field": "price",
        "font": "noto_serif_bold",
        "font_size": 42,
        "line_height": 48,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 8
      },
      {
        "type": "text",
        "field": "change_24h",
        "color": "red",
        "font": "noto_serif_bold",
        "font_size": 20,
        "align": "center"
      },
      {
        "type": "spacer",
        "height": 14
      },
      {
        "type": "separator",
        "line_width": 1,
        "dashed": true
      },
      {
        "type": "spacer",
        "height": 8
      },
      {
        "type": "key_value",
        "items": [
          { "label": "24h High", "field": "high_24h" },
          { "label": "24h Low", "field": "low_24h" }
        ],
        "font_size": 12,
        "align": "center"
      }
    ],
    "footer": {
      "label": "Crypto Ticker",
      "attribution_template": "Updated at {update_time}"
    }
  }
}
