{
  "mode_id": "GCORES_NEWS",
  "display_name": "Gcores News",
  "icon": "newspaper",
  "cacheable": true,
  "description": "Daily news, gaming updates, films, and tech pop culture from Gcores.",
  "settings_schema": [],
  "content": {
    "type": "computed",
    "provider": "gcores_news",
    "fallback": {
      "header_tag": "GCORES · DAILY NEWS",
      "title": "Charming 3D puzzle platformer 'Wander in the Wonder Woods' officially launched today",
      "category_badge": "Global News",
      "summary": "Crafted with passion by an indie team, the fantasy adventure is out on major platforms with stunning aesthetics and clever box-garden mechanics.",
      "published_at": "Today",
      "cover_url": "https://image.gcores.com/fb3ad8d73ad3751143c67758abbf1584-1536-1024.jpg",
      "footer_label": "GCORES NEWS · GAMES & TECH RADAR"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "NEWS",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "category_badge",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "Gcores Media",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "News Header Photo",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Gcores News",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "text",
          "field": "title",
          "font": "noto_serif_bold",
          "font_size": 12,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "text",
          "field": "summary",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "badge",
              "field": "category_badge",
              "variant": "outline",
              "radius": 3
            },
            {
              "type": "text",
              "field": "published_at",
              "font_size": 9
            }
          ]
        }
      ]
    }
  }
}
