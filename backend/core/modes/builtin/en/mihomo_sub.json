{
  "mode_id": "MIHOMO_SUB",
  "display_name": "Mihomo Subscription",
  "icon": "activity",
  "cacheable": false,
  "description": "Mihomo container monitor, proxy subscription validity, remaining days, and quota dashboard for single and multiple subscriptions",
  "settings_schema": [
    {
      "key": "subscription_url",
      "label": "Subscription URL (Supports multiple lines)",
      "type": "text",
      "placeholder": "Leave empty for auto-detection; or enter one per line (Name|URL)"
    },
    {
      "key": "api_url",
      "label": "Mihomo API URL",
      "type": "text",
      "default": "http://mihomo-cliproxy:9090",
      "placeholder": "http://mihomo-cliproxy:9090 or http://127.0.0.1:9090"
    },
    {
      "key": "api_secret",
      "label": "Mihomo Secret (Optional)",
      "type": "password",
      "placeholder": "Leave empty for auto-discovery"
    },
    {
      "key": "name",
      "label": "Subscription Name (Single Sub)",
      "type": "text",
      "placeholder": "e.g. My Airport / Mihomo Proxy"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "mihomo_sub",
    "fallback": {
      "title": "MIHOMO Subscriptions Dashboard",
      "sub_count": 2,
      "has_multiple_subs": true,
      "provider_name": "main-channel",
      "core_version": "Mihomo Meta alpha",
      "status_pill": "Online",
      "active_node": "CHANNEL",
      "node_count": "23 Nodes",
      "update_time": "12:00",
      "footer_label": "Clash.Meta · Subscription Monitor",
      "footer_right": "Synced at 12:00",
      "total_str": "300.0 GB",
      "used_str": "206.1 GB",
      "remaining_str": "93.9 GB",
      "upload_str": "0 B",
      "download_str": "206.1 GB",
      "used_percent_str": "68.7%",
      "progress_percent": 68,
      "expire_str": "2027-08-20",
      "days_left_badge": "347 Days Left",
      "total_all_str": "800.0 GB",
      "used_all_str": "260.0 GB",
      "remaining_all_str": "540.0 GB",
      "used_all_percent_str": "32.5%",
      "progress_all_percent": 32,
      "earliest_days_badge": "347 Days Left",
      "sub_1_name": "main-channel",
      "sub_1_used_str": "206.1 GB",
      "sub_1_total_str": "300.0 GB",
      "sub_1_remaining_str": "93.9 GB",
      "sub_1_percent_str": "68.7%",
      "sub_1_progress": 68,
      "sub_1_expire_str": "2027-08-20",
      "sub_1_days_badge": "347 Days Left",
      "sub_2_name": "backup-channel",
      "sub_2_used_str": "53.8 GB",
      "sub_2_total_str": "500.0 GB",
      "sub_2_remaining_str": "446.2 GB",
      "sub_2_percent_str": "10.8%",
      "sub_2_progress": 11,
      "sub_2_expire_str": "2029-09-08",
      "sub_2_days_badge": "1097 Days Left"
    }
  },
  "layout": {
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 3
      },
      {
        "type": "conditional",
        "field": "sub_count",
        "conditions": [
          {
            "op": "gt",
            "value": 1,
            "children": [
              {
                "type": "card",
                "border": "solid",
                "radius": 4,
                "padding": 5,
                "margin_x": 10,
                "children": [
                  {
                    "type": "flex_row",
                    "justify": "space-between",
                    "align_items": "center",
                    "margin_x": 0,
                    "items": [
                      {
                        "type": "text",
                        "template": "MIHOMO Subscriptions",
                        "font": "noto_serif_bold",
                        "font_size": 13,
                        "align": "left",
                        "margin_x": 0
                      },
                      {
                        "type": "badge",
                        "template": "{sub_count} Subscriptions",
                        "font_size": 10,
                        "align": "right",
                        "margin_x": 0
                      }
                    ]
                  },
                  {
                    "type": "separator",
                    "style": "dashed",
                    "margin_top": 3,
                    "margin_bottom": 4
                  },
                  {
                    "type": "text",
                    "template": "Available: {remaining_all_str}  ·  Used: {used_all_str} / {total_all_str} ({used_all_percent_str})",
                    "font": "noto_serif_regular",
                    "font_size": 10,
                    "align": "left",
                    "margin_x": 0
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 4
              },
              {
                "type": "card",
                "border": "solid",
                "radius": 4,
                "padding": 5,
                "margin_x": 10,
                "children": [
                  {
                    "type": "flex_row",
                    "justify": "space-between",
                    "align_items": "center",
                    "margin_x": 0,
                    "items": [
                      {
                        "type": "text",
                        "template": "{sub_1_name}",
                        "font": "noto_serif_bold",
                        "font_size": 13,
                        "align": "left",
                        "margin_x": 0
                      },
                      {
                        "type": "badge",
                        "template": "{sub_1_expire_str} · {sub_1_days_badge}",
                        "font_size": 10,
                        "align": "right",
                        "margin_x": 0
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "template": "Rem: {sub_1_remaining_str}  ·  Used: {sub_1_used_str} / {sub_1_total_str} ({sub_1_percent_str})",
                    "font": "noto_serif_regular",
                    "font_size": 10,
                    "align": "left",
                    "margin_x": 0,
                    "margin_bottom": 3
                  },
                  {
                    "type": "progress_bar",
                    "field": "sub_1_progress",
                    "max_value": 100,
                    "height": 6,
                    "margin_x": 0,
                    "margin_bottom": 1
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 4
              },
              {
                "type": "card",
                "border": "solid",
                "radius": 4,
                "padding": 5,
                "margin_x": 10,
                "children": [
                  {
                    "type": "flex_row",
                    "justify": "space-between",
                    "align_items": "center",
                    "margin_x": 0,
                    "items": [
                      {
                        "type": "text",
                        "template": "{sub_2_name}",
                        "font": "noto_serif_bold",
                        "font_size": 13,
                        "align": "left",
                        "margin_x": 0
                      },
                      {
                        "type": "badge",
                        "template": "{sub_2_expire_str} · {sub_2_days_badge}",
                        "font_size": 10,
                        "align": "right",
                        "margin_x": 0
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "template": "Rem: {sub_2_remaining_str}  ·  Used: {sub_2_used_str} / {sub_2_total_str} ({sub_2_percent_str})",
                    "font": "noto_serif_regular",
                    "font_size": 10,
                    "align": "left",
                    "margin_x": 0,
                    "margin_bottom": 3
                  },
                  {
                    "type": "progress_bar",
                    "field": "sub_2_progress",
                    "max_value": 100,
                    "height": 6,
                    "margin_x": 0,
                    "margin_bottom": 1
                  }
                ]
              }
            ]
          }
        ],
        "fallback_children": [
          {
            "type": "card",
            "border": "solid",
            "radius": 4,
            "padding": 6,
            "margin_x": 10,
            "children": [
              {
                "type": "flex_row",
                "justify": "space-between",
                "align_items": "center",
                "margin_x": 0,
                "items": [
                  {
                    "type": "text",
                    "template": "{provider_name}",
                    "font": "noto_serif_bold",
                    "font_size": 15,
                    "align": "left",
                    "margin_x": 0
                  },
                  {
                    "type": "badge",
                    "template": "{status_pill}",
                    "align": "right",
                    "margin_x": 0
                  }
                ]
              },
              {
                "type": "separator",
                "style": "dashed",
                "margin_top": 4,
                "margin_bottom": 6
              },
              {
                "type": "two_column",
                "ratio": "5:5",
                "margin_x": 0,
                "gap": 10,
                "left": [
                  {
                    "type": "text",
                    "text": "Remaining Data",
                    "font": "noto_serif_regular",
                    "font_size": 10,
                    "align": "left",
                    "margin_x": 0
                  },
                  {
                    "type": "text",
                    "template": "{remaining_str}",
                    "font": "noto_serif_bold",
                    "font_size": 26,
                    "align": "left",
                    "margin_x": 0,
                    "margin_bottom": 4
                  },
                  {
                    "type": "badge",
                    "template": "{days_left_badge}",
                    "align": "left",
                    "margin_x": 0
                  }
                ],
                "right": [
                  {
                    "type": "key_value",
                    "font_size": 10,
                    "items": [
                      { "label": "Used", "template": "{used_str} ({used_percent_str})" },
                      { "label": "Total", "template": "{total_str}" },
                      { "label": "Expires", "template": "{expire_str}" },
                      { "label": "Nodes", "template": "{node_count}" }
                    ]
                  }
                ]
              },
              {
                "type": "separator",
                "style": "dashed",
                "margin_top": 6,
                "margin_bottom": 4
              },
              {
                "type": "text",
                "template": "Data Usage: {used_str} / {total_str} ({used_percent_str})",
                "font": "noto_serif_regular",
                "font_size": 10,
                "align": "left",
                "margin_x": 0,
                "margin_bottom": 3
              },
              {
                "type": "progress_bar",
                "field": "progress_percent",
                "max_value": 100,
                "height": 7,
                "margin_x": 0,
                "margin_bottom": 2
              }
            ]
          }
        ]
      }
    ],
    "footer": {
      "attribution_template": "{core_version} · {active_node}"
    }
  }
}
