{
  "mode_id": "DISASTER_ALERT",
  "display_name": "Disaster Alert",
  "icon": "alert-triangle",
  "cacheable": false,
  "description": "National Emergency Disaster & Weather Warning Broadcast",
  "settings_schema": [
    {
      "key": "level",
      "label": "Warning Level",
      "type": "select",
      "default": "红色",
      "options": [
        { "value": "红色", "label": "Red Alert (Level I Most Severe)" },
        { "value": "橙色", "label": "Orange Alert (Level II Severe)" },
        { "value": "黄色", "label": "Yellow Alert (Level III Moderate)" },
        { "value": "蓝色", "label": "Blue Alert (Level IV Minor)" }
      ]
    },
    {
      "key": "hazard",
      "label": "Hazard Type",
      "type": "select",
      "default": "暴雨",
      "options": [
        { "value": "暴雨", "label": "Rainstorm / Flood" },
        { "value": "台风", "label": "Typhoon / Gale" },
        { "value": "暴雪", "label": "Blizzard / Ice" },
        { "value": "大风", "label": "Strong Wind" },
        { "value": "高温", "label": "Heatwave" },
        { "value": "寒潮", "label": "Cold Wave" },
        { "value": "地震", "label": "Earthquake" },
        { "value": "森林火险", "label": "Wildfire" },
        { "value": "海啸", "label": "Tsunami" },
        { "value": "冰雹", "label": "Hailstorm" },
        { "value": "沙尘暴", "label": "Sandstorm" },
        { "value": "大雾", "label": "Dense Fog" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "disaster_alert",
    "level": "红色",
    "hazard": "暴雨",
    "fallback": {
      "level": "Red",
      "type_name": "Rainstorm",
      "hazard_key": "rainstorm",
      "title": "【Rainstorm Red Alert】",
      "sender": "National Disaster Prevention Center",
      "pub_time": "12:00",
      "text": "Severe rainstorm warning active. Please take emergency precautions immediately.",
      "advice": [
        "Stay indoors and avoid underground passages or culverts.",
        "Disconnect outdoor vulnerable power sources in low areas.",
        "Be alert to mountain torrents and geological hazards."
      ],
      "theme_color": "red"
    }
  },
  "layout": {
    "body_align": "top",
    "body": [
      {
        "type": "disaster_hero",
        "hazard_template": "{hazard_key}",
        "type_name_template": "{type_name}",
        "level_template": "{level}",
        "icon_size": 70,
        "title_font_size": 20,
        "margin_bottom": 10
      },
      {
        "type": "text",
        "field": "text",
        "font": "inter_regular",
        "font_size": 11,
        "line_height": 16,
        "align": "left",
        "margin_x": 12,
        "max_lines": 2,
        "margin_bottom": 6
      },
      {
        "type": "disaster_advice_box",
        "title": "Safety Precaution Guidelines",
        "items_field": "advice",
        "margin_x": 12,
        "margin_bottom": 6
      },
      {
        "type": "disaster_publisher_bar",
        "sender_template": "{sender}",
        "time_template": "{pub_time}",
        "margin_x": 12
      }
    ]
  }
}
