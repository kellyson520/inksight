{
  "mode_id": "STEAM_ACHIEVEMENTS",
  "display_name": "Steam Achievements",
  "icon": "award",
  "cacheable": true,
  "description": "Show recent games and unlocked achievements on Steam.",
  "settings_schema": [
    {
      "key": "steam_url",
      "label": "Steam Profile URL (Optional, defaults to account settings)",
      "type": "text",
      "placeholder": "https://steamcommunity.com/profiles/76561198978201763/"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "steam_achievements",
    "fallback": {
      "persona_name": "O_0",
      "level": "11",
      "game_name": "Sid Meier's Civilization VI",
      "cover_url": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/289070/header.jpg",
      "hours_total": "62.0 hrs",
      "progress_label": "Unlocked 37 / 320 Achievements",
      "progress_pct": 12,
      "progress_text": "12%",
      "ach1_name": "Alfred Wegener's Legacy",
      "ach2_name": "Land Party",
      "ach3_name": "Investment Banking",
      "footer_label": "STEAM ACHIEVEMENTS · PROGRESS"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 4,
            "items": [
              {
                "type": "text",
                "field": "persona_name",
                "font": "noto_serif_bold",
                "font_size": 13
              },
              {
                "type": "badge",
                "field": "hours_total",
                "variant": "filled",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "game_name",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 19,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "margin_bottom": 3,
            "items": [
              {
                "type": "text",
                "field": "progress_label",
                "font_size": 11,
                "color": "black"
              },
              {
                "type": "text",
                "field": "progress_text",
                "font_size": 11,
                "font": "noto_serif_bold",
                "color": "black"
              }
            ]
          },
          {
            "type": "progress_bar",
            "field": "progress_pct",
            "max_val": 100,
            "height": 5,
            "margin_bottom": 6
          },
          {
            "type": "text",
            "text": "Recent Achievements:",
            "font_size": 10,
            "color": "gray",
            "margin_bottom": 3
          },
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 4,
            "margin_bottom": 2,
            "items": [
              {
                "type": "badge",
                "text": "🏆",
                "variant": "outline",
                "radius": 3
              },
              {
                "type": "text",
                "field": "ach1_name",
                "font_size": 11,
                "max_lines": 1
              }
            ]
          },
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 4,
            "margin_bottom": 2,
            "items": [
              {
                "type": "badge",
                "text": "🏆",
                "variant": "outline",
                "radius": 3
              },
              {
                "type": "text",
                "field": "ach2_name",
                "font_size": 11,
                "max_lines": 1
              }
            ]
          },
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 4,
            "items": [
              {
                "type": "badge",
                "text": "🏆",
                "variant": "outline",
                "radius": 3
              },
              {
                "type": "text",
                "field": "ach3_name",
                "font_size": 11,
                "max_lines": 1
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "field": "progress_text",
            "font": "noto_serif_bold",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Steam Achievements",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "field": "game_name",
              "font": "noto_serif_bold",
              "font_size": 12,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "progress_text",
              "variant": "filled",
              "radius": 3
            }
          ]
        },
        {
          "type": "progress_bar",
          "field": "progress_pct",
          "max_val": 100,
          "height": 4,
          "margin_x": 6,
          "margin_bottom": 3
        },
        {
          "type": "text",
          "field": "ach1_name",
          "font_size": 10,
          "margin_x": 6,
          "max_lines": 1
        }
      ]
    }
  }
}
