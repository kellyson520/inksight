{
  "mode_id": "MIYOUSHE_NEWS",
  "display_name": "HoYoLAB News",
  "icon": "bell",
  "cacheable": true,
  "description": "Official notices, events, and bulletins from Genshin Impact, Star Rail, ZZZ, and Honkai 3.",
  "settings_schema": [
    {
      "key": "game",
      "label": "Selected Game",
      "type": "select",
      "default": "GENSHIN",
      "options": [
        { "value": "GENSHIN", "label": "Genshin Impact" },
        { "value": "STAR_RAIL", "label": "Honkai: Star Rail" },
        { "value": "ZZZ", "label": "Zenless Zone Zero" },
        { "value": "HONKAI3", "label": "Honkai Impact 3rd" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "miyoushe_news",
    "fallback": {
      "game_badge": "Genshin Impact",
      "title": "Version 5.0 Event Wishes and Special Events Announced",
      "category_tag": "Official Events · Bulletins",
      "summary": "Join the new version events to earn Primogems, character materials, and exclusive celebration gifts!",
      "published_at": "Today",
      "cover_url": "https://dummyimage.com/640x360/284b63/ffffff.png&text=HOYOLAB+NEWS",
      "footer_label": "HOYOLAB · OFFICIAL NOTICES"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "field": "game_badge",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "category_tag",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "HoYo Community",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Official Poster",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "HoYoLAB News",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "text",
          "field": "title",
          "font": "noto_serif_bold",
          "font_size": 12,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "text",
          "field": "summary",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "badge",
              "field": "game_badge",
              "variant": "outline",
              "radius": 3
            },
            {
              "type": "text",
              "field": "published_at",
              "font_size": 9
            }
          ]
        }
      ]
    }
  }
}
