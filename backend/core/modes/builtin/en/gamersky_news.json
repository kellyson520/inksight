{
  "mode_id": "GAMERSKY_NEWS",
  "display_name": "GamerSky News",
  "icon": "gamepad-2",
  "cacheable": true,
  "description": "Latest PC and console gaming news, upcoming releases, and hardware updates.",
  "settings_schema": [],
  "content": {
    "type": "computed",
    "provider": "gamersky_news",
    "fallback": {
      "header_tag": "GAMERSKY · GAMING NEWS",
      "title": "The Witcher 3 Next-Gen Comparison Footage Released by CDPR",
      "source_tag": "GAMERSKY Console News",
      "summary": "Next-gen lighting, enhanced textures, and ray-tracing upgrades showcase full visual evolution for both new and returning players.",
      "published_at": "Today",
      "cover_url": "https://imgs.gamersky.com/upimg/new_preview/2026/09/24/origin_b_202609241802146453.jpg",
      "footer_label": "GAMERSKY · PC & CONSOLE UPDATES"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "PC & CONSOLE",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "source_tag",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "GamerSky Community",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "News Thumbnail",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "GamerSky News",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "text",
          "field": "title",
          "font": "noto_serif_bold",
          "font_size": 12,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "text",
          "field": "summary",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "badge",
              "text": "GAMERSKY",
              "variant": "outline",
              "radius": 3
            },
            {
              "type": "text",
              "field": "published_at",
              "font_size": 9
            }
          ]
        }
      ]
    }
  }
}
