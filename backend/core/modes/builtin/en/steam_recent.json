{
  "mode_id": "STEAM_RECENT",
  "display_name": "Steam Recent Games",
  "icon": "clock",
  "cacheable": true,
  "description": "Recently played games on Steam, with 2-week and total playtime stats.",
  "settings_schema": [
    {
      "key": "steam_url",
      "label": "Steam Profile URL (Optional, defaults to account settings)",
      "type": "text",
      "placeholder": "https://steamcommunity.com/profiles/76561198978201763/"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "steam_recent",
    "fallback": {
      "persona_name": "O_0",
      "level": "11",
      "game1_name": "Sid Meier's Civilization VI",
      "game1_cover": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/289070/capsule_184x69.jpg",
      "game1_hours_total": "Total 62.0h",
      "game1_hours_2w": "2 Weeks 12.5h",
      "game2_name": "It Takes Two",
      "game2_cover": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426210/capsule_184x69.jpg",
      "game2_hours_total": "Total 22.0h",
      "game2_hours_2w": "2 Weeks 3.0h",
      "game3_name": "Palworld",
      "game3_cover": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623730/capsule_184x69.jpg",
      "game3_hours_total": "Total 0.4h",
      "game3_hours_2w": "2 Weeks 0.4h",
      "footer_label": "STEAM RECENT · PLAYTIME LOG"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 4,
            "items": [
              {
                "type": "text",
                "field": "persona_name",
                "font": "noto_serif_bold",
                "font_size": 13
              },
              {
                "type": "badge",
                "text": "RECENTLY PLAYED",
                "variant": "filled",
                "radius": 4
              }
            ]
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 1,
            "items": [
              {
                "type": "text",
                "field": "game1_name",
                "font": "noto_serif_bold",
                "font_size": 13,
                "max_lines": 1
              },
              {
                "type": "badge",
                "field": "game1_hours_2w",
                "variant": "outline",
                "radius": 3
              }
            ]
          },
          {
            "type": "text",
            "field": "game1_hours_total",
            "font_size": 10,
            "color": "gray",
            "margin_bottom": 4
          },
          {
            "type": "separator",
            "line_width": 1,
            "margin_x": 0
          },
          {
            "type": "spacer",
            "height": 3
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 1,
            "items": [
              {
                "type": "text",
                "field": "game2_name",
                "font": "noto_serif_bold",
                "font_size": 13,
                "max_lines": 1
              },
              {
                "type": "badge",
                "field": "game2_hours_2w",
                "variant": "outline",
                "radius": 3
              }
            ]
          },
          {
            "type": "text",
            "field": "game2_hours_total",
            "font_size": 10,
            "color": "gray",
            "margin_bottom": 4
          },
          {
            "type": "separator",
            "line_width": 1,
            "margin_x": 0
          },
          {
            "type": "spacer",
            "height": 3
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 1,
            "items": [
              {
                "type": "text",
                "field": "game3_name",
                "font": "noto_serif_bold",
                "font_size": 13,
                "max_lines": 1
              },
              {
                "type": "badge",
                "field": "game3_hours_2w",
                "variant": "outline",
                "radius": 3
              }
            ]
          },
          {
            "type": "text",
            "field": "game3_hours_total",
            "font_size": 10,
            "color": "gray"
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "game1_cover",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Most Played Recently",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Steam Recent Games",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "field": "game1_name",
              "font": "noto_serif_bold",
              "font_size": 11,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "game1_hours_2w",
              "variant": "outline",
              "radius": 3
            }
          ]
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "text",
              "field": "game2_name",
              "font": "noto_serif_bold",
              "font_size": 11,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "game2_hours_2w",
              "variant": "outline",
              "radius": 3
            }
          ]
        }
      ]
    }
  }
}
