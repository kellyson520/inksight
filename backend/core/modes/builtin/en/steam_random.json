{
  "mode_id": "STEAM_RANDOM",
  "display_name": "Steam What to Play",
  "icon": "shuffle",
  "cacheable": true,
  "description": "Randomly picks a game from your public Steam library to help you decide what to play today.",
  "settings_schema": [
    {
      "key": "steam_url",
      "label": "Steam Profile URL (Optional, defaults to account settings)",
      "type": "text",
      "placeholder": "https://steamcommunity.com/profiles/76561198978201763/"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "steam_random",
    "fallback": {
      "persona_name": "O_0",
      "picked_game": "Sid Meier's Civilization VI",
      "playtime_badge": "62.0 Hours Played",
      "ach_badge": "12% Achievements",
      "recommend_reason": "Just one more turn! Dive into world conquest and strategic mastery.",
      "cover_url": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/289070/header.jpg",
      "footer_label": "STEAM TODAY · RANDOM PICK"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "🎲 RANDOM PICK",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "persona_name",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "picked_game",
            "font": "noto_serif_bold",
            "font_size": 16,
            "max_lines": 2,
            "line_height": 21,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "field": "playtime_badge",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "ach_badge",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "recommend_reason",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 17,
            "margin_bottom": 4
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Steam Library Pick",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Steam What to Play",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "field": "picked_game",
              "font": "noto_serif_bold",
              "font_size": 12,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "playtime_badge",
              "variant": "filled",
              "radius": 3
            }
          ]
        },
        {
          "type": "text",
          "field": "recommend_reason",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6
        }
      ]
    }
  }
}
