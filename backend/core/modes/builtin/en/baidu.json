{
  "mode_id": "BAIDU",
  "display_name": "Baidu Hot Search",
  "icon": "search",
  "cacheable": true,
  "description": "Real-time search trends, breaking news, and popular search topics from Baidu.",
  "settings_schema": [
    {
      "key": "style",
      "label": "Layout Style",
      "type": "select",
      "default": "dense_grid",
      "options": [
        { "value": "dense_grid", "label": "Dense Two-Column Cards (Top 8)" },
        { "value": "cover_card", "label": "Cover Card & Illustrated List" },
        { "value": "editorial", "label": "Editorial Focus Magazine" },
        { "value": "classic", "label": "Classic Pill Rank List" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "hotlist",
    "platform": "baidu",
    "style": "dense_grid",
    "fallback": {
      "platform_title": "Baidu Hot Search",
      "style_badge": "Realtime",
      "update_time": "Live",
      "item_1": "1. Breakthroughs in room-temperature quantum computing",
      "item_2": "2. How AI is transforming daily productivity and engineering",
      "item_3": "3. Deep space probes transmit unprecedented high-res photos",
      "item_4": "4. Proven habits for deep mental focus and health",
      "item_5": "5. Top curated books and technical documentaries this month",
      "item_6": "6. Next-generation low-power e-ink display innovations",
      "item_7": "7. Global climate & energy innovation digest",
      "item_8": "8. Digital minimalism and mental focus practices"
    }
  },
  "layout": {
    "body_align": "left",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "flex_row",
        "justify": "space_between",
        "align_items": "center",
        "gap": 8,
        "items": [
          {
            "type": "badge",
            "field": "platform_title",
            "variant": "solid",
            "bg_color": "blue",
            "color": "white",
            "font_size": 13,
            "padding_x": 10,
            "padding_y": 3,
            "radius": 5
          },
          {
            "type": "badge",
            "field": "style_badge",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          }
        ]
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "separator",
        "line_width": 1,
        "dashed": true
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "hotlist_board"
      }
    ],
    "footer": {
      "label": "Baidu Hot Search",
      "attribution_template": "Updated at {update_time}"
    }
  }
}
