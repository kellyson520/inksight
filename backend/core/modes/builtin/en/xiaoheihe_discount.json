{
  "mode_id": "XIAOHEIHE_DISCOUNT",
  "display_name": "Game Deals",
  "icon": "tag",
  "cacheable": true,
  "description": "Featured video game discounts, historic low price alerts, and random sale picks.",
  "settings_schema": [
    {
      "key": "endpoint",
      "label": "Custom Discounts API (Optional)",
      "type": "text",
      "placeholder": "https://example.com/discounts.json"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "xiaoheihe_discount",
    "fallback": {
      "header_title": "FEATURED · GAME SALE",
      "game_name": "It Takes Two",
      "discount_badge": "-70%",
      "current_price": "$11.99",
      "original_price": "$39.99",
      "cut_price": "Save $28.00",
      "historical_status": "Historic Low",
      "rating_label": "Overwhelmingly Positive",
      "deadline_label": "Special Promotion",
      "tag_list": "Co-op · Adventure · Action",
      "cover_url": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426210/header.jpg",
      "description": "Embark on the craziest journey of your life in It Takes Two, a genre-bending platform adventure created purely for co-op.",
      "footer_label": "GAME DEALS · DAILY SELECTION"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "HOT DEAL",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "discount_badge",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "game_name",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "field": "current_price",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "original_price",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "description",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 4,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "field": "rating_label",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "deadline_label",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "field": "cut_price",
            "font": "noto_serif_bold",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Game Deals",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "field": "game_name",
              "font": "noto_serif_bold",
              "font_size": 12,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "discount_badge",
              "variant": "filled",
              "radius": 3
            }
          ]
        },
        {
          "type": "flex_row",
          "justify": "start",
          "gap": 6,
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "badge",
              "field": "current_price",
              "variant": "filled",
              "radius": 3
            },
            {
              "type": "badge",
              "field": "original_price",
              "variant": "outline",
              "radius": 3
            }
          ]
        },
        {
          "type": "text",
          "field": "description",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6
        }
      ]
    }
  }
}
