{
  "mode_id": "CHUAPP_ARTICLES",
  "display_name": "ChuApp Articles",
  "icon": "file-text",
  "cacheable": true,
  "description": "Heartfelt stories and in-depth humanistic journalism on games and players from ChuApp.",
  "settings_schema": [],
  "content": {
    "type": "computed",
    "provider": "chuapp_articles",
    "fallback": {
      "header_tag": "CHUAPP · HUMAN STORIES",
      "title": "EA Sports FC 27: Open Worlds, Digital Collections, and Letting Go",
      "author": "ChuApp Contributing Writer",
      "summary": "Documenting games and the people behind them. Uncovering genuine passion, persistence, and memories on and off the digital pitch.",
      "published_at": "Today",
      "cover_url": "http://img.chuapp.com/wp-content/Picture/2026-09-23/6ab3948658aaa.jpg?imageView2/2/w/700",
      "footer_label": "CHUAPP · GAMING & HUMANITY"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "CHUAPP",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "author",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "ChuApp Stories",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Article Photo",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "ChuApp Articles",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "text",
          "field": "title",
          "font": "noto_serif_bold",
          "font_size": 12,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "text",
          "field": "summary",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "badge",
              "field": "author",
              "variant": "outline",
              "radius": 3
            },
            {
              "type": "text",
              "field": "published_at",
              "font_size": 9
            }
          ]
        }
      ]
    }
  }
}
