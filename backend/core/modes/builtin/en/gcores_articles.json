{
  "mode_id": "GCORES_ARTICLES",
  "display_name": "Gcores Articles",
  "icon": "book-open",
  "cacheable": true,
  "description": "In-depth gaming culture, design evolution, and lifestyle essays from Gcores authors.",
  "settings_schema": [],
  "content": {
    "type": "computed",
    "provider": "gcores_articles",
    "fallback": {
      "header_tag": "GCORES · ESSAY",
      "title": "Looking Back at the Golden Era: Immersive Sim Design and Its Future",
      "author": "Special Columnist",
      "summary": "From Thief and System Shock to Dishonored: how level design constructs unmatched immersion and player freedom in fictional realms.",
      "published_at": "Today",
      "cover_url": "https://image.gcores.com/b873bd4612e30607865d1b86be9b9c14-1920-1080.jpg",
      "footer_label": "GCORES ESSAY · DEEP CULTURE"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "ESSAY",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "author",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "Gcores Feature",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Column Artwork",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Gcores Articles",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
