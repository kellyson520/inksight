{
  "mode_id": "STEAM_FRIENDS",
  "display_name": "Steam Friends Status",
  "icon": "users",
  "cacheable": true,
  "description": "Show friend online and in-game statuses to see what everyone is playing.",
  "settings_schema": [
    {
      "key": "steam_url",
      "label": "Steam Profile URL (Optional, defaults to account settings)",
      "type": "text",
      "placeholder": "https://steamcommunity.com/profiles/76561198978201763/"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "steam_friends",
    "fallback": {
      "header_title": "STEAM FRIENDS",
      "status_summary": "Online: 2 · In-Game: 1",
      "cover_url": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/730/header.jpg",
      "f1_dot": "●",
      "f1_name": "Hank Garcia",
      "f1_status": "In-Game",
      "f1_game": "Counter-Strike 2",
      "f2_dot": "●",
      "f2_name": "James Allen",
      "f2_status": "Online",
      "f2_game": "Online",
      "f3_dot": "○",
      "f3_name": "kelly",
      "f3_status": "Offline",
      "f3_game": "Last online 7h ago",
      "f4_dot": "○",
      "f4_name": "Momo.368",
      "f4_status": "Offline",
      "f4_game": "Last online 1d ago",
      "f5_dot": "○",
      "f5_name": "YANG",
      "f5_status": "Offline",
      "f5_game": "Last online 2d ago",
      "footer_label": "STEAM FRIENDS · ONLINE RADAR"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 4,
            "items": [
              {
                "type": "text",
                "field": "header_title",
                "font": "noto_serif_bold",
                "font_size": 13
              },
              {
                "type": "badge",
                "field": "status_summary",
                "variant": "filled",
                "radius": 4
              }
            ]
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 2,
            "items": [
              {
                "type": "text",
                "text": "{f1_dot} {f1_name}",
                "font": "noto_serif_bold",
                "font_size": 12,
                "max_lines": 1
              },
              {
                "type": "badge",
                "field": "f1_game",
                "variant": "outline",
                "radius": 3
              }
            ]
          },
          {
            "type": "separator",
            "line_width": 1,
            "margin_x": 0
          },
          {
            "type": "spacer",
            "height": 3
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 2,
            "items": [
              {
                "type": "text",
                "text": "{f2_dot} {f2_name}",
                "font": "noto_serif_bold",
                "font_size": 12,
                "max_lines": 1
              },
              {
                "type": "badge",
                "field": "f2_game",
                "variant": "outline",
                "radius": 3
              }
            ]
          },
          {
            "type": "separator",
            "line_width": 1,
            "margin_x": 0
          },
          {
            "type": "spacer",
            "height": 3
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 2,
            "items": [
              {
                "type": "text",
                "text": "{f3_dot} {f3_name}",
                "font": "noto_serif_bold",
                "font_size": 12,
                "max_lines": 1
              },
              {
                "type": "badge",
                "field": "f3_game",
                "variant": "outline",
                "radius": 3
              }
            ]
          },
          {
            "type": "separator",
            "line_width": 1,
            "margin_x": 0
          },
          {
            "type": "spacer",
            "height": 3
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "items": [
              {
                "type": "text",
                "text": "{f4_dot} {f4_name}",
                "font": "noto_serif_bold",
                "font_size": 12,
                "max_lines": 1
              },
              {
                "type": "badge",
                "field": "f4_game",
                "variant": "outline",
                "radius": 3
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Friends Radar",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Steam Friends Status",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "text": "{f1_dot} {f1_name}",
              "font": "noto_serif_bold",
              "font_size": 11,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "f1_game",
              "variant": "outline",
              "radius": 3
            }
          ]
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "text",
              "text": "{f2_dot} {f2_name}",
              "font": "noto_serif_bold",
              "font_size": 11,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "f2_game",
              "variant": "outline",
              "radius": 3
            }
          ]
        }
      ]
    }
  }
}
