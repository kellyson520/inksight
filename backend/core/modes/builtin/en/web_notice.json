{
  "mode_id": "WEB_NOTICE",
  "display_name": "Change Notice",
  "icon": "bell",
  "cacheable": false,
  "description": "Smart web & endpoint change monitor notice, interrupts display when change detected",
  "content": {
    "type": "static",
    "site_name": "Monitored Site",
    "title": "Page Content Updated",
    "url_short": "https://example.com/status",
    "change_time": "15:30",
    "prev_snippet": "Previous: v1.0.0 Released",
    "new_snippet": "Updated: v1.1.0 Refactored version published",
    "footer_hint": "Smart Event Alert · Recovers automatically after presentations"
  },
  "layout": {
    "body_align": "center",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "alert_callout",
        "title": "Web Change Detected",
        "level": "warning",
        "tag": "WEB WATCHER",
        "margin_x": 12,
        "margin_bottom": 8
      },
      {
        "type": "flex_row",
        "justify": "space_between",
        "align_items": "center",
        "margin_x": 14,
        "items": [
          {
            "type": "text",
            "field": "site_name",
            "font": "noto_serif_bold",
            "font_size": 17
          },
          {
            "type": "badge",
            "field": "change_time",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          }
        ]
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "text",
        "field": "url_short",
        "font": "noto_serif_light",
        "font_size": 10,
        "align": "left",
        "margin_x": 14
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "change_diff_card",
        "margin_x": 12,
        "prev_field": "prev_snippet",
        "new_field": "new_snippet",
        "margin_bottom": 8
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "text",
        "field": "footer_hint",
        "font": "noto_serif_light",
        "font_size": 10,
        "align": "center"
      }
    ],
    "footer": {
      "label": "Event Notification",
      "attribution_template": "InkSight Event Interceptor Engine"
    }
  }
}
