{
  "mode_id": "GCORES_PODCAST",
  "display_name": "Gcores Podcast",
  "icon": "headphones",
  "cacheable": true,
  "description": "Featured podcasts from Gcores Radio, spanning gaming culture, deep discussions, and music.",
  "settings_schema": [
    {
      "key": "program",
      "label": "Program Category",
      "type": "select",
      "default": "ALL",
      "options": [
        { "value": "ALL", "label": "All Episodes (Latest)" },
        { "value": "PRO", "label": "Gadio Pro (Core Culture & Games)" },
        { "value": "LIFE", "label": "Gadio Life (Casual Stories & Chat)" },
        { "value": "MUSIC", "label": "Gadio Music (Soundtracks & Tracks)" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "gcores_podcast",
    "fallback": {
      "header_tag": "GCORES · PODCAST",
      "title": "Gadio Pro: Shanghai Espionage Chronicles Part IV",
      "program_tag": "Gadio Pro · Deep Dive",
      "summary": "How intelligence and logistics officers navigated the dangerous underworld of Old Shanghai, funding secret operations and rescuing comrades.",
      "published_at": "Sep 23, 21:00",
      "cover_url": "https://image.gcores.com/bfb3ba42d6f73b33295dad5130939a73-1600-900.jpg",
      "footer_label": "GCORES RADIO · SHARE THE PASSION"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "RADIO",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "program_tag",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "Gcores Gadio",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Podcast Episode Cover",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Gcores Podcast",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "field": "title",
              "font": "noto_serif_bold",
              "font_size": 12,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "program_tag",
              "variant": "filled",
              "radius": 3
            }
          ]
        },
        {
          "type": "text",
          "field": "summary",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "text",
          "field": "published_at",
          "font_size": 9,
          "margin_x": 6
        }
      ]
    }
  }
}
