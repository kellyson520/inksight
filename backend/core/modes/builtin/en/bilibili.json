{
  "mode_id": "BILIBILI",
  "display_name": "Bilibili Popular",
  "icon": "tv",
  "cacheable": true,
  "description": "Trending videos, creator spotlights, and popular multimedia productions from Bilibili.",
  "settings_schema": [
    {
      "key": "style",
      "label": "Layout Style",
      "type": "select",
      "default": "cover_card",
      "options": [
        { "value": "cover_card", "label": "Cover Card & Illustrated List" },
        { "value": "dense_grid", "label": "Dense Two-Column Cards (Top 8)" },
        { "value": "editorial", "label": "Editorial Focus Magazine" },
        { "value": "classic", "label": "Classic Pill Rank List" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "hotlist",
    "platform": "bilibili",
    "style": "cover_card",
    "fallback": {
      "platform_title": "Bilibili Popular",
      "style_badge": "Popular",
      "update_time": "Live",
      "item_1": "1. 30yo studying bachelor degree again: thoughts & life",
      "item_2": "2. How generative AI is reshaping modern multimedia design",
      "item_3": "3. Deep space probes transmit unprecedented galaxy photos",
      "item_4": "4. Proven habits for deep mental focus and health",
      "item_5": "5. Top curated books and technical documentaries this month",
      "item_6": "6. Next-generation low-power e-ink display innovations",
      "item_7": "7. Documentary showcase: polar climate exploration",
      "item_8": "8. Music production and sound engineering insights"
    }
  },
  "layout": {
    "body_align": "left",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "flex_row",
        "justify": "space_between",
        "align_items": "center",
        "gap": 8,
        "items": [
          {
            "type": "badge",
            "field": "platform_title",
            "variant": "solid",
            "bg_color": "purple",
            "color": "white",
            "font_size": 13,
            "padding_x": 10,
            "padding_y": 3,
            "radius": 5
          },
          {
            "type": "badge",
            "field": "style_badge",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          }
        ]
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "separator",
        "line_width": 1,
        "dashed": true
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "hotlist_board"
      }
    ],
    "footer": {
      "label": "Bilibili Popular",
      "attribution_template": "Updated at {update_time}"
    }
  }
}
