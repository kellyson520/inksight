    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 12,
        "gap": 12,
        "left_ratio": 0.64,
        "right_ratio": 0.36,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "badge",
            "field": "rank_tag",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          },
          {
            "type": "spacer",
            "height": 6
          },
          {
            "type": "text",
            "field": "title_bracketed",
            "font": "noto_serif_bold",
            "font_size": 17,
            "line_height": 22,
            "align": "left",
            "max_lines": 2
          },
          {
            "type": "spacer",
            "height": 4
          },
          {
            "type": "text",
            "field": "director_line",
            "font": "noto_serif_regular",
            "font_size": 11,
            "line_height": 16,
            "align": "left",
            "max_lines": 1
          },
          {
            "type": "spacer",
            "height": 6
          },
          {
            "type": "separator",
            "line_width": 1,
            "dashed": true
          },
          {
            "type": "spacer",
            "height": 6
          },
          {
            "type": "text",
            "field": "recommend_reason",
            "font": "noto_serif_regular",
            "font_size": 11,
            "line_height": 17,
            "align": "left",
            "max_lines": 5
          },
          {
            "type": "spacer",
            "height": 8
          },
          {
            "type": "flex_row",
            "justify": "start",
            "align_items": "center",
            "gap": 6,
            "items": [
              {
                "type": "badge",
                "field": "rating_label",
                "variant": "solid",
                "bg_color": "red",
                "color": "white",
