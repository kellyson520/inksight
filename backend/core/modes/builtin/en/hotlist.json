{
  "mode_id": "HOTLIST",
  "display_name": "Trending Feeds",
  "icon": "flame",
  "cacheable": true,
  "description": "Live trending topics from Zhihu, Weibo, Bilibili, GitHub Trending, etc.",
  "settings_schema": [
    {
      "key": "platform",
      "label": "Trending Platform",
      "type": "select",
      "default": "zhihu",
      "options": [
        { "value": "zhihu", "label": "Zhihu Trending" },
        { "value": "weibo", "label": "Weibo Hot Search" },
        { "value": "bilibili", "label": "Bilibili Hot" },
        { "value": "github", "label": "GitHub Trending" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "hotlist",
    "platform": "zhihu",
    "fallback": {
      "platform_title": "Zhihu Trending",
      "update_time": "Live",
      "item_1": "1. Breakthroughs in room-temperature quantum computing",
      "item_2": "2. How AI is transforming daily productivity and engineering",
      "item_3": "3. Deep space probes transmit unprecedented high-res photos",
      "item_4": "4. Proven habits for deep mental focus and health",
      "item_5": "5. Top curated books and technical documentaries this month"
    }
  },
  "layout": {
    "body_align": "left",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "flex_row",
        "justify": "center",
        "align_items": "center",
        "gap": 8,
        "items": [
          {
            "type": "badge",
            "field": "platform_title",
            "variant": "solid",
            "bg_color": "red",
            "color": "white",
            "font_size": 13,
            "padding_x": 10,
            "padding_y": 3,
            "radius": 6
          },
          {
            "type": "badge",
            "text": "TOP 5",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          }
        ]
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "separator",
        "line_width": 1,
        "dashed": true
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "text",
        "field": "item_1",
        "font": "noto_serif_regular",
        "font_size": 14,
        "line_height": 20,
        "align": "left"
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "text",
        "field": "item_2",
        "font": "noto_serif_regular",
        "font_size": 14,
        "line_height": 20,
        "align": "left"
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "text",
        "field": "item_3",
        "font": "noto_serif_regular",
        "font_size": 14,
        "line_height": 20,
        "align": "left"
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "text",
        "field": "item_4",
        "font": "noto_serif_regular",
        "font_size": 14,
        "line_height": 20,
        "align": "left"
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "text",
        "field": "item_5",
        "font": "noto_serif_regular",
        "font_size": 14,
        "line_height": 20,
        "align": "left"
      }
    ],
    "footer": {
      "label": "Trending Aggregator",
      "attribution_template": "Updated at {update_time}"
    }
  }
}
