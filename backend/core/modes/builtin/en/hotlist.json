{
  "mode_id": "HOTLIST",
  "display_name": "Trending Feeds",
  "icon": "flame",
  "cacheable": true,
  "description": "Live trending topics from Zhihu, Weibo, Bilibili, Douyin, 36Kr, SSPAI, GitHub Trending, etc.",
  "settings_schema": [
    {
      "key": "platforms",
      "label": "Trending Platforms (Multi-select)",
      "type": "multiselect",
      "default": ["zhihu", "weibo"],
      "options": [
        { "value": "zhihu", "label": "Zhihu Trending" },
        { "value": "weibo", "label": "Weibo Hot Search" },
        { "value": "bilibili", "label": "Bilibili Hot" },
        { "value": "douyin", "label": "Douyin Viral" },
        { "value": "baidu", "label": "Baidu Hot Search" },
        { "value": "36kr", "label": "36Kr Tech" },
        { "value": "sspai", "label": "SSPAI Prime" },
        { "value": "ithome", "label": "ITHome Tech" },
        { "value": "tieba", "label": "Tieba Topics" },
        { "value": "github", "label": "GitHub Trending" }
      ]
    },
    {
      "key": "style",
      "label": "Board Style",
      "type": "select",
      "default": "dense_grid",
      "options": [
        { "value": "dense_grid", "label": "Dense Two-Column Cards" },
        { "value": "editorial", "label": "Editorial Focus Magazine" },
        { "value": "classic", "label": "Classic Pill Rank List" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "hotlist",
    "platforms": ["zhihu", "weibo"],
    "style": "dense_grid",
    "fallback": {
      "platform_title": "Global Trending Feed",
      "style_badge": "Curated",
      "update_time": "Live",
      "item_1": "1. Breakthroughs in room-temperature quantum computing",
      "item_2": "2. How AI is transforming daily productivity and engineering",
      "item_3": "3. Deep space probes transmit unprecedented high-res photos",
      "item_4": "4. Proven habits for deep mental focus and health",
      "item_5": "5. Top curated books and technical documentaries this month",
      "item_6": "6. Next-generation low-power e-ink display innovations"
    }
  },
  "layout": {
    "body_align": "left",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "flex_row",
        "justify": "space_between",
        "align_items": "center",
        "gap": 8,
        "items": [
          {
            "type": "badge",
            "field": "platform_title",
            "variant": "solid",
            "bg_color": "red",
            "color": "white",
            "font_size": 13,
            "padding_x": 10,
            "padding_y": 3,
            "radius": 5
          },
          {
            "type": "badge",
            "field": "style_badge",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          }
        ]
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "separator",
        "line_width": 1,
        "dashed": true
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "hotlist_board"
      }
    ],
    "footer": {
      "label": "Trending News Wire",
      "attribution_template": "Updated at {update_time}"
    }
  }
}
