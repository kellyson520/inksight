{
  "mode_id": "WEBHOOK",
  "display_name": "Open Data Card",
  "icon": "layout-dashboard",
  "cacheable": false,
  "description": "Custom IoT and home automation dashboard received via HTTP POST webhook",
  "settings_schema": [
    {
      "key": "title",
      "label": "Card Title",
      "type": "text",
      "default": "Environment & Energy",
      "placeholder": "Enter card title"
    },
    {
      "key": "primary_metric",
      "label": "Primary Metric",
      "type": "text",
      "default": "23.6°C",
      "placeholder": "e.g. 23.6°C or 99.8%"
    },
    {
      "key": "primary_label",
      "label": "Primary Label",
      "type": "text",
      "default": "Room Temperature",
      "placeholder": "e.g. Room Temp"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "webhook",
    "fallback": {
      "title": "Environment & Energy",
      "primary_metric": "23.6°C",
      "primary_label": "Room Temperature",
      "status_tag": "Optimal",
      "item_1_label": "Humidity",
      "item_1_value": "48%",
      "item_2_label": "PM2.5",
      "item_2_value": "12 μg/m³",
      "item_3_label": "Daily Power",
      "item_3_value": "4.2 kWh",
      "timestamp": "12:00"
    }
  },
  "layout": {
    "body_align": "center",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 8,
        "padding": 8,
        "margin_x": 12,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_x": 6,
            "items": [
              {
                "type": "text",
                "field": "title",
                "font": "noto_serif_bold",
                "font_size": 16
              },
              {
                "type": "badge",
                "field": "status_tag",
                "variant": "solid",
                "bg_color": "red",
                "color": "white",
                "font_size": 11,
                "padding_x": 6,
                "padding_y": 2,
                "radius": 4
              }
            ]
          },
          {
            "type": "spacer",
            "height": 6
          },
          {
            "type": "text",
            "field": "primary_metric",
            "color": "red",
            "font": "noto_serif_bold",
            "font_size": 38,
            "align": "center"
          },
          {
            "type": "text",
            "field": "primary_label",
            "font": "noto_serif_regular",
            "font_size": 13,
            "align": "center"
          },
          {
            "type": "spacer",
            "height": 8
          },
          {
            "type": "separator",
            "style": "dashed",
            "line_width": 1
          },
          {
            "type": "spacer",
            "height": 6
          },
          {
            "type": "grid",
            "columns": 3,
            "show_divider": true,
            "margin_x": 4,
            "font_size": 10,
            "value_size": 12,
            "items": [
              { "label": "{item_1_label}", "field": "item_1_value" },
              { "label": "{item_2_label}", "field": "item_2_value" },
              { "label": "{item_3_label}", "field": "item_3_value" }
            ]
          }
        ]
      }
    ],
    "footer": {
      "label": "IoT Open Card",
      "attribution_template": "Received at {timestamp}"
    }
  }
}
