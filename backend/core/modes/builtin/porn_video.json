{
  "mode_id": "PORN_VIDEO",
  "display_name": "P站视频推荐",
  "icon": "video",
  "cacheable": true,
  "description": "P站公开推荐视频，精美视频播放卡片，不需要登录",
  "settings_schema": [
    {
      "key": "layout_style",
      "label": "展示样式",
      "type": "select",
      "default": "cover_card",
      "options": [
        {"value": "cover_card", "label": "视频卡片"},
        {"value": "ranking", "label": "排行榜"}
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "porn_video",
    "fallback": {
      "title": "P站公开视频推荐",
      "source": "P站",
      "items": [
        {
          "title": "公开推荐视频",
          "subtitle": "P站",
          "rank_label": "推荐",
          "duration": "14:28",
          "views_label": "128万次播放",
          "rating_label": "98%好评"
        }
      ]
    }
  },
  "layout": {
    "body_align": "top",
    "body": [
      {
        "type": "text",
        "template": "{title}",
        "font": "noto_serif_bold",
        "font_size": 15,
        "margin_x": 10,
        "margin_bottom": 4
      },
      {
        "type": "recommendation",
        "field": "items",
        "style_field": "layout_style",
        "max_items": 5,
        "font_size": 10,
        "margin_x": 0
      }
    ],
    "footer": {
      "label": "P VIDEO",
      "attribution_template": "{source}"
    }
  }
}
