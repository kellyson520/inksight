{
  "mode_id": "WEBHOOK",
  "display_name": "开放数据卡片",
  "icon": "layout-dashboard",
  "cacheable": false,
  "description": "接收第三方系统 (Home Assistant, 自建监控脚本, 传感器等) 通过 HTTP POST 投递的自定义数据卡片",
  "settings_schema": [
    {
      "key": "title",
      "label": "卡片标题",
      "type": "text",
      "default": "家庭环境与能耗",
      "placeholder": "输入仪表盘标题"
    },
    {
      "key": "primary_metric",
      "label": "核心大字指标",
      "type": "text",
      "default": "23.6°C",
      "placeholder": "如 23.6°C 或 99.8%"
    },
    {
      "key": "primary_label",
      "label": "核心指标副标",
      "type": "text",
      "default": "室内舒适温度",
      "placeholder": "如 室内温度"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "webhook",
    "fallback": {
      "title": "环境监控与能耗",
      "primary_metric": "23.6°C",
      "primary_label": "室内舒适温度",
      "status_tag": "优良",
      "item_1_label": "空气湿度",
      "item_1_value": "48% 舒适",
      "item_2_label": "PM2.5",
      "item_2_value": "12 μg/m³",
      "item_3_label": "今日用电",
      "item_3_value": "4.2 kWh",
      "timestamp": "12:00"
    }
  },
  "layout": {
    "body_align": "center",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 8,
        "padding": 8,
        "margin_x": 12,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_x": 6,
            "items": [
              {
                "type": "text",
                "field": "title",
                "font": "noto_serif_bold",
                "font_size": 16
              },
              {
                "type": "badge",
                "field": "status_tag",
                "variant": "solid",
                "bg_color": "red",
                "color": "white",
                "font_size": 11,
                "padding_x": 6,
                "padding_y": 2,
                "radius": 4
              }
            ]
          },
          {
            "type": "spacer",
            "height": 6
          },
          {
            "type": "text",
            "field": "primary_metric",
            "color": "red",
            "font": "noto_serif_bold",
            "font_size": 38,
            "align": "center"
          },
          {
            "type": "text",
            "field": "primary_label",
            "font": "noto_serif_regular",
            "font_size": 13,
            "align": "center"
          },
          {
            "type": "spacer",
            "height": 8
          },
          {
            "type": "separator",
            "style": "dashed",
            "line_width": 1
          },
          {
            "type": "spacer",
            "height": 6
          },
          {
            "type": "grid",
            "columns": 3,
            "show_divider": true,
            "margin_x": 4,
            "font_size": 10,
            "value_size": 12,
            "items": [
              { "label": "{item_1_label}", "field": "item_1_value" },
              { "label": "{item_2_label}", "field": "item_2_value" },
              { "label": "{item_3_label}", "field": "item_3_value" }
            ]
          }
        ]
      }
    ],
    "footer": {
      "label": "开放物联卡片",
      "attribution_template": "接收于 {timestamp}"
    }
  }
}
