{
  "mode_id": "EPIC_FREE",
  "display_name": "Epic喜加一",
  "icon": "gift",
  "cacheable": true,
  "description": "查看Epic喜加一活动，快速了解当前或下一期的免费游戏。",
  "settings_schema": [
    {
      "key": "endpoint",
      "label": "自定义喜加一接口（可选）",
      "type": "text",
      "placeholder": "https://example.com/epic.json"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "epic_free",
    "fallback": {
      "header_title": "EPIC GAMES · 喜加一",
      "game_title": "《幽灵行者 2》 (Ghostrunner II)",
      "status_label": "本周免费",
      "original_price": "原价 ¥169.00",
      "deadline_label": "截止 09月26日 23:00",
      "cover_url": "https://dummyimage.com/640x360/1a1a24/ffffff.png&text=GHOSTRUNNER+II",
      "description": "第一人称赛博朋克砍杀动作游戏，在毁灭后的达摩塔外荒原展开高速跑酷与激烈斩击！一键入库，终身畅玩。",
      "claim_url": "https://store.epicgames.com/",
      "footer_label": "EPIC FREE GAMES · 喜加一活动"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "EPIC 喜加一",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "status_label",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "game_title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "FREE 免费",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "original_price",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "description",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 4,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "官方限免活动",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "deadline_label",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "Epic Games Store",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "Epic喜加一",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "field": "game_title",
              "font": "noto_serif_bold",
              "font_size": 12,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "status_label",
              "variant": "filled",
              "radius": 3
            }
          ]
        },
        {
          "type": "text",
          "field": "description",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "badge",
              "field": "original_price",
              "variant": "outline",
              "radius": 3
            },
            {
              "type": "text",
              "field": "deadline_label",
              "font_size": 9
            }
          ]
        }
      ]
    }
  }
}
