{
  "mode_id": "CPA_QUOTA",
  "display_name": "额度与认证看板",
  "icon": "gauge",
  "category": "productivity",
  "cacheable": false,
  "description": "监控本地 CPA 容器与 Keeper 容器的认证文件重置时间、已用量、用户消费与模型排行",
  "settings_schema": [
    {
      "key": "view",
      "label": "看板视图",
