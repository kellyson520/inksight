{
  "mode_id": "CPA_QUOTA",
  "display_name": "额度与认证看板",
  "icon": "gauge",
  "category": "productivity",
  "cacheable": false,
  "description": "监控本地 CPA 容器与 Keeper 容器的认证文件重置时间、已用量、用户消费与模型排行",
  "settings_schema": [
    {
      "key": "view",
      "label": "看板视图",
      "type": "select",
      "options": [
        { "value": "auths", "label": "认证文件与限额 (双重置+环形进度)" },
        { "value": "overview", "label": "综合总览 (认证+账单+模型)" },
        { "value": "users", "label": "用户消费排行 (Key账单)" },
        { "value": "models", "label": "模型消耗分布 (Token吞吐)" }
      ],
      "default": "auths"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "cpa_quota",
    "fallback": {
      "title": "本地认证文件与限额看板",
      "header_status": "CPA 在线 · Keeper 在线",
      "summary_1_label": "运行中文件",
      "summary_1_val": "2 个",
      "summary_2_label": "5小时窗口重置",
      "summary_2_val": "2时45分",
      "summary_3_label": "7天窗口重置",
      "summary_3_val": "6天0时",
      "card_1_title": "AA  [CODEX]",
      "card_1_status": "• 正常调用中",
      "card_1_reset_text": "5h重置: 2时45分   7天重置: 6天0时",
      "card_1_usage_text": "已用: 2.87B Tokens · 26,139 次请求",
      "card_1_ring_val": "85",
      "card_2_title": "huo02  [ANTIGRAVITY]",
      "card_2_status": "• 正常调用中",
      "card_2_reset_text": "5h重置: 持续可用   7天重置: 持续可用",
      "card_2_usage_text": "已用: 485.5M Tokens · 3,370 次请求",
      "card_2_ring_val": "100",
      "reset_bottom_label": "监控认证文件: 2 个  ·  今日总 Token: 85.6M",
      "update_time": "12:00:00"
    }
  },
  "layout": {
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 3
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 4,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_x": 4,
            "margin_bottom": 0,
            "items": [
              {
                "type": "text",
                "field": "title",
                "font": "noto_serif_bold",
                "font_size": 13
              },
              {
                "type": "badge",
                "field": "header_status",
                "font_size": 9,
                "padding_x": 5,
                "padding_y": 1
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 4,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-around",
            "align_items": "center",
            "margin_bottom": 1,
            "items": [
              {
                "type": "text",
                "field": "summary_1_label",
                "font": "noto_serif_regular",
                "font_size": 9,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_2_label",
                "font": "noto_serif_regular",
                "font_size": 9,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_3_label",
                "font": "noto_serif_regular",
                "font_size": 9,
                "align": "center"
              }
            ]
          },
          {
            "type": "flex_row",
            "justify": "space-around",
            "align_items": "center",
            "margin_bottom": 0,
            "items": [
              {
                "type": "text",
                "field": "summary_1_val",
                "font": "noto_serif_bold",
                "font_size": 13,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_2_val",
                "font": "noto_serif_bold",
                "font_size": 13,
                "align": "center"
              },
              {
                "type": "text",
                "field": "summary_3_val",
                "font": "noto_serif_bold",
                "font_size": 13,
                "align": "center"
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 5,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "two_column",
            "ratio": 0.82,
            "margin_x": 0,
            "gap": 6,
            "left_align_y": "center",
            "right_align_y": "center",
            "left": [
              {
                "type": "flex_row",
                "justify": "left",
                "align_items": "center",
                "margin_bottom": 3,
                "items": [
                  { "type": "text", "field": "card_1_title", "font": "noto_serif_bold", "font_size": 11 },
                  { "type": "spacer", "width": 6 },
                  { "type": "text", "field": "card_1_status", "font": "noto_serif_regular", "font_size": 9 }
                ]
              },
              {
                "type": "text",
                "field": "card_1_reset_text",
                "font": "noto_serif_bold",
                "font_size": 10,
                "margin_bottom": 2
              },
              {
                "type": "text",
                "field": "card_1_usage_text",
                "font": "noto_serif_regular",
                "font_size": 9,
                "margin_bottom": 0
              }
            ],
            "right": [
              {
                "type": "progress_ring",
                "field": "card_1_ring_val",
                "size": 42,
                "label": "剩余配额",
                "margin_bottom": 0
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 3,
        "padding": 5,
        "margin_x": 8,
        "margin_bottom": 3,
        "children": [
          {
            "type": "two_column",
            "ratio": 0.82,
            "margin_x": 0,
            "gap": 6,
            "left_align_y": "center",
            "right_align_y": "center",
            "left": [
              {
                "type": "flex_row",
                "justify": "left",
                "align_items": "center",
                "margin_bottom": 3,
                "items": [
                  { "type": "text", "field": "card_2_title", "font": "noto_serif_bold", "font_size": 11 },
                  { "type": "spacer", "width": 6 },
                  { "type": "text", "field": "card_2_status", "font": "noto_serif_regular", "font_size": 9 }
                ]
              },
              {
                "type": "text",
                "field": "card_2_reset_text",
                "font": "noto_serif_bold",
                "font_size": 10,
                "margin_bottom": 2
              },
              {
                "type": "text",
                "field": "card_2_usage_text",
                "font": "noto_serif_regular",
                "font_size": 9,
                "margin_bottom": 0
              }
            ],
            "right": [
              {
                "type": "progress_ring",
                "field": "card_2_ring_val",
                "size": 42,
                "label": "配额充沛",
                "margin_bottom": 0
              }
            ]
          }
        ]
      },
      {
        "type": "flex_row",
        "justify": "space-between",
        "align_items": "center",
        "margin_x": 10,
        "margin_bottom": 0,
        "items": [
          {
            "type": "text",
            "field": "reset_bottom_label",
            "font": "noto_serif_regular",
            "font_size": 9
          },
          {
            "type": "text",
            "field": "update_time",
            "font": "noto_serif_regular",
            "font_size": 9
          }
        ]
      }
    ]
  }
}
