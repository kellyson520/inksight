{
  "mode_id": "CPA_QUOTA",
  "display_name": "额度与认证看板",
  "icon": "gauge",
  "category": "productivity",
  "cacheable": false,
  "description": "监控本地 CPA 容器与 Keeper 容器的认证文件重置时间、已用量、用户消费与模型排行",
  "settings_schema": [
    {
      "key": "view",
      "label": "看板视图",
      "type": "select",
      "options": [
        { "value": "auths", "label": "认证文件与限额 (重置时间+用量)" },
        { "value": "overview", "label": "综合总览 (认证+账单+模型)" },
        { "value": "users", "label": "用户消费排行 (Key账单)" },
        { "value": "models", "label": "模型消耗分布 (Token吞吐)" }
      ],
      "default": "auths"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "cpa_quota",
    "fallback": {
      "title": "本地认证文件与限额看板",
      "header_status": "CPA 在线 · Keeper 在线",
      "summary_1_label": "认证文件",
      "summary_1_val": "4 个",
      "summary_2_label": "窗口重置倒计时",
      "summary_2_val": "3时38分",
      "summary_3_label": "今日总 Token",
      "summary_3_val": "75.3M",
      "col_left_title": "🔑 认证账号 / 渠道",
      "col_right_title": "⏳ 限额重置与已用量",
      "card_1_left_name": "CODEX · AA",
      "card_1_left_val": "已用: 2.87B (26138次)",
      "card_1_right_name": "AA 配额",
      "card_1_right_val": "重置: 3时38分 · 剩余: 85%",
      "card_2_left_name": "ANTIGRAVITY · huo02",
      "card_2_left_val": "已用: 482.9M (3370次)",
      "card_2_right_name": "huo02 配额",
      "card_2_right_val": "重置: 无需重置 · 剩余: 100%",
      "card_3_left_name": "GEMINI · h",
      "card_3_left_val": "已用: 224.0K (43次)",
      "card_3_right_name": "h 配额",
      "card_3_right_val": "重置: 无需重置 · 剩余: 100%",
