{
  "mode_id": "HOTLIST",
  "display_name": "全网热点",
  "icon": "flame",
  "cacheable": true,
  "description": "实时聚合网易云热歌、豆瓣电影、抖音、微信、知乎、微博、B站、36氪、少数派、IT之家等平台多源热搜与精选资讯",
  "settings_schema": [
    {
      "key": "platforms",
      "label": "热榜平台(可多选)",
      "type": "multiselect",
      "default": ["netease", "douban", "douyin", "wechat"],
      "options": [
        { "value": "netease", "label": "网易云音乐热歌榜" },
        { "value": "douban", "label": "豆瓣电影热门榜" },
        { "value": "douyin", "label": "抖音实时热点" },
        { "value": "wechat", "label": "微信精选热榜" },
        { "value": "zhihu", "label": "知乎热榜" },
        { "value": "weibo", "label": "微博热搜" },
        { "value": "bilibili", "label": "B站热门" },
        { "value": "baidu", "label": "百度热搜" },
        { "value": "36kr", "label": "36氪热榜" },
        { "value": "sspai", "label": "少数派" },
        { "value": "ithome", "label": "IT之家" },
        { "value": "tieba", "label": "百度贴吧" },
        { "value": "github", "label": "GitHub Trending" }
      ]
    },
    {
      "key": "style",
      "label": "排版样式",
      "type": "select",
      "default": "dense_grid",
      "options": [
        { "value": "dense_grid", "label": "双列高密度卡片看板" },
        { "value": "editorial", "label": "杂志焦点头条精选" },
        { "value": "classic", "label": "精致胶囊单列排行" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "hotlist",
    "platforms": ["zhihu", "weibo"],
    "style": "dense_grid",
    "fallback": {
      "platform_title": "全网实时热点",
      "style_badge": "焦点精选",
      "update_time": "实时",
      "item_1": "1. 科学家在常温超导与量子计算领域取得新突破",
      "item_2": "2. 人工智能重塑数字生产力与前沿工作流",
      "item_3": "3. 深空探测器传回太阳系边缘超高清影像",
      "item_4": "4. 建立健康生活节奏与专注习惯实践指南",
      "item_5": "5. 本周精选科技前沿观察与开源创新项目",
      "item_6": "6. 探索新一代低功耗电子墨水屏技术前沿"
    }
  },
  "layout": {
    "body_align": "left",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "flex_row",
        "justify": "space_between",
        "align_items": "center",
        "gap": 8,
        "items": [
          {
            "type": "badge",
            "field": "platform_title",
            "variant": "solid",
            "bg_color": "red",
            "color": "white",
            "font_size": 13,
            "padding_x": 10,
            "padding_y": 3,
            "radius": 5
          },
          {
            "type": "badge",
            "field": "style_badge",
            "variant": "outline",
            "font_size": 11,
            "padding_x": 6,
            "padding_y": 2,
            "radius": 4
          }
        ]
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "separator",
        "line_width": 1,
        "dashed": true
      },
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "hotlist_board"
      }
    ],
    "footer": {
      "label": "全网热点精选",
      "attribution_template": "更新于 {update_time}"
    }
  }
}
