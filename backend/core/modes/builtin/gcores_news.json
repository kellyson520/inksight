{
  "mode_id": "GCORES_NEWS",
  "display_name": "机核 资讯",
  "icon": "newspaper",
  "cacheable": true,
  "description": "阅读机核关于游戏、影视、科技与流行文化的最新资讯。",
  "settings_schema": [],
  "content": {
    "type": "computed",
    "provider": "gcores_news",
    "fallback": {
      "header_tag": "机核 · 每日游戏资讯",
      "title": "治愈系3D平台解谜游戏《不思议林中漫游》今日正式发售",
      "category_badge": "全球资讯",
      "summary": "由独立团队精心打造的奇幻解谜冒险，现已登录各主流平台。唯美画风与精巧箱庭机关带来绝佳沉浸体验。",
      "published_at": "今日更新",
      "cover_url": "https://dummyimage.com/640x360/e23e3e/ffffff.png&text=GCORES+NEWS",
      "footer_label": "GCORES NEWS · 游戏影视科技速递"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "card",
        "border": "solid",
        "radius": 8,
        "padding": 8,
        "margin_x": 10,
        "margin_bottom": 6,
        "children": [
          {
            "type": "flex_row",
            "justify": "space-between",
            "align_items": "center",
            "margin_bottom": 6,
            "items": [
              {
                "type": "text",
                "field": "header_tag",
                "font": "noto_serif_bold",
                "font_size": 13
              },
              {
                "type": "badge",
                "field": "category_badge",
                "variant": "filled",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 17,
            "max_lines": 2,
            "line_height": 22,
            "margin_bottom": 6
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 12,
            "max_lines": 4,
            "line_height": 18,
            "margin_bottom": 6
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "机核网 GCORES",
                "font_size": 11,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 11,
                "color": "black"
              }
            ]
          }
        ]
      }
    ],
    "footer": {
      "label": "机核资讯",
      "attribution_template": "{footer_label}"
    }
  }
}
