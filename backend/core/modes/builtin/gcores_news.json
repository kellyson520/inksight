{
  "mode_id": "GCORES_NEWS",
  "display_name": "机核 资讯",
  "icon": "newspaper",
  "cacheable": true,
  "description": "阅读机核关于游戏、影视、科技与流行文化的最新资讯。",
  "settings_schema": [],
  "content": {
    "type": "computed",
    "provider": "gcores_news",
    "fallback": {
      "header_tag": "机核 · 每日游戏资讯",
      "title": "治愈系3D平台解谜游戏《不思议林中漫游》今日正式发售",
      "category_badge": "全球资讯",
      "summary": "由独立团队精心打造的奇幻解谜冒险，现已登录各主流平台。唯美画风与精巧箱庭机关带来绝佳沉浸体验。",
      "published_at": "今日更新",
      "cover_url": "https://dummyimage.com/640x360/e23e3e/ffffff.png&text=GCORES+NEWS",
      "footer_label": "GCORES NEWS · 游戏影视科技速递"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "机核快讯",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "category_badge",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "机核网 GCORES",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "资讯配图速递",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "机核资讯",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "text",
          "field": "title",
          "font": "noto_serif_bold",
          "font_size": 12,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "text",
          "field": "summary",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "items": [
            {
              "type": "badge",
              "field": "category_badge",
              "variant": "outline",
              "radius": 3
            },
            {
              "type": "text",
              "field": "published_at",
              "font_size": 9
            }
          ]
        }
      ]
    }
  }
}
