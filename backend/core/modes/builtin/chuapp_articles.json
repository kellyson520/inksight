{
  "mode_id": "CHUAPP_ARTICLES",
  "display_name": "触乐 最新文章",
  "icon": "file-text",
  "cacheable": true,
  "description": "阅读触乐最新文章，了解游戏与玩家背后的故事。",
  "settings_schema": [],
  "content": {
    "type": "computed",
    "provider": "chuapp_articles",
    "fallback": {
      "header_tag": "触乐 · 游戏人文故事",
      "title": "《EA Sports FC 27》：足球开放世界、模拟收纳与断舍离",
      "author": "触乐特约作者",
      "summary": "记录游戏与人，寻找那些值得被记录的玩家故事。在数字绿茵场内外，重新思考电子游戏带给普通人的热忱与释怀。",
      "published_at": "今日发布",
      "cover_url": "http://img.chuapp.com/wp-content/Picture/2026-09-23/6ab3948658aaa.jpg?imageView2/2/w/700",
      "footer_label": "CHUAPP · 触乐网深度故事"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "触乐专栏",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "author",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "触乐网 · 人物纪实",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "触乐故事配图",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "触乐最新文章",
      "attribution_template": "{footer_label}"
    }
  }
}
