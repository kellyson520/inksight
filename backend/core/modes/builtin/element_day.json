                "padding": 4,
                "children": [
                  {
                    "type": "text",
                    "template": "{atomic_number}",
                    "font": "noto_serif_bold",
                    "font_size": 11,
                    "align": "left"
                  },
                  {
                    "type": "text",
                    "template": "{symbol}",
                    "font": "noto_serif_bold",
                    "font_size": 32,
                    "align": "center"
                  },
                  {
                    "type": "text",
                    "template": "{atomic_mass}",
                    "font": "noto_serif_regular",
                    "font_size": 9,
                    "align": "center"
                  }
                ]
              }
            ],
            "right": [
              {
                "type": "text",
                "template": "{name_zh} · {name_en}",
                "font": "noto_serif_bold",
                "font_size": 16,
                "align": "left"
              },
              {
                "type": "badge",
                "template": "{category}  |  {phase}",
                "align": "left"
              },
              {
                "type": "text",
                "template": "电子排布: {electron_config}",
                "font": "noto_serif_regular",
                "font_size": 10,
                "align": "left"
              },
              {
                "type": "text",
                "template": "发现: {discoverer}",
                "font": "noto_serif_regular",
                "font_size": 9,
                "align": "left"
              }
            ]
          }
        ]
      },
      {
        "type": "spacer",
        "height": 6
      },
      {
        "type": "section",
        "title": "科学概貌",
        "margin_x": 12,
