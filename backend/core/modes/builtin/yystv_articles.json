            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "游研专栏",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "author",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "游研社 YYSTV",
