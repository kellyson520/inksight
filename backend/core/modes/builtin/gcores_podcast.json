{
  "mode_id": "GCORES_PODCAST",
  "display_name": "机核 播客",
  "icon": "headphones",
  "cacheable": true,
  "description": "选择机核播客栏目，收听最新一期节目。",
  "settings_schema": [
    {
      "key": "program",
      "label": "播客栏目分类",
      "type": "select",
      "default": "ALL",
      "options": [
        { "value": "ALL", "label": "全部栏目 (最新节目)" },
        { "value": "PRO", "label": "Gadio Pro (核心对谈与文化)" },
        { "value": "LIFE", "label": "Gadio Life (生活与日常唠嗑)" },
        { "value": "MUSIC", "label": "Gadio Music (音乐主题专栏)" }
      ]
    }
  ],
  "content": {
    "type": "computed",
    "provider": "gcores_podcast",
    "fallback": {
      "header_tag": "机核网 · 最新电台",
      "title": "上海谍战风云录 第四期丨长袖善舞",
      "program_tag": "Gadio Pro · 深度对谈",
      "summary": "特科总务科与情报科如何一明一暗、长袖善舞，在上海滩扎下根基，以商养党、营救同志、周旋险境。",
      "published_at": "09-23 21:00",
      "cover_url": "https://dummyimage.com/640x360/e23e3e/ffffff.png&text=GCORES+RADIO",
      "footer_label": "GCORES RADIO · 分享热爱的声音"
    }
  },
  "layout": {
    "body_align": "top",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "body": [
      {
        "type": "spacer",
        "height": 4
      },
      {
        "type": "two_column",
        "margin_x": 10,
        "gap": 10,
        "left_ratio": 0.60,
        "right_ratio": 0.40,
        "left_align_y": "top",
        "right_align_y": "top",
        "left_blocks": [
          {
            "type": "flex_row",
            "justify": "start",
            "gap": 6,
            "margin_bottom": 4,
            "items": [
              {
                "type": "badge",
                "text": "机核电台",
                "variant": "filled",
                "radius": 4
              },
              {
                "type": "badge",
                "field": "program_tag",
                "variant": "outline",
                "radius": 4
              }
            ]
          },
          {
            "type": "text",
            "field": "title",
            "font": "noto_serif_bold",
            "font_size": 15,
            "max_lines": 2,
            "line_height": 20,
            "margin_bottom": 4
          },
          {
            "type": "text",
            "field": "summary",
            "font": "noto_serif_light",
            "font_size": 11,
            "max_lines": 5,
            "line_height": 16,
            "margin_bottom": 4
          },
          {
            "type": "flex_row",
            "justify": "space-between",
            "items": [
              {
                "type": "text",
                "text": "机核网 Gadio",
                "font_size": 10,
                "color": "gray"
              },
              {
                "type": "text",
                "field": "published_at",
                "font_size": 10,
                "color": "black"
              }
            ]
          }
        ],
        "right_blocks": [
          {
            "type": "image",
            "field": "cover_url",
            "width": 138,
            "height": 178,
            "fit": "cover",
            "photo_enhance": true,
            "margin_bottom": 4
          },
          {
            "type": "centered_text",
            "text": "电台专栏封面",
            "font": "noto_serif_light",
            "font_size": 10
          }
        ]
      }
    ],
    "footer": {
      "label": "机核播客",
      "attribution_template": "{footer_label}"
    }
  },
  "layout_overrides": {
    "296x128": {
      "body_align": "top",
      "body": [
        {
          "type": "spacer",
          "height": 2
        },
        {
          "type": "flex_row",
          "justify": "space-between",
          "margin_x": 6,
          "margin_bottom": 2,
          "items": [
            {
              "type": "text",
              "field": "title",
              "font": "noto_serif_bold",
              "font_size": 12,
              "max_lines": 1
            },
            {
              "type": "badge",
              "field": "program_tag",
              "variant": "filled",
              "radius": 3
            }
          ]
        },
        {
          "type": "text",
          "field": "summary",
          "font": "noto_serif_light",
          "font_size": 9,
          "max_lines": 2,
          "margin_x": 6,
          "margin_bottom": 2
        },
        {
          "type": "text",
          "field": "published_at",
          "font_size": 9,
          "margin_x": 6
        }
      ]
    }
  }
}
